<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>WinDoesNot</vendor>
  <vendor_url>https://windoesnot.me</vendor_url>
  <action id="me.windoesnot.store.helper">
    <description>Manage packages with WinDoesNot Store</description>
    <description xml:lang="de">Pakete mit dem WinDoesNot Store verwalten</description>
    <message>Authentication is required to install, remove or update software</message>
    <message xml:lang="de">Zum Installieren, Entfernen oder Aktualisieren von Software ist eine Anmeldung erforderlich</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/windoesnot-store-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
